# Variables de entorno y credenciales
.env
.env.*
!.env.example

# Archivos multimedia subidos por usuarios (preserva la carpeta pero no las imágenes locales)
uploaded_img/*
!uploaded_img/.gitkeep

# Archivos comprimidos y copias de seguridad
*.zip
*.rar
*.7z
*.tar.gz
*.tar
*.bak
*.old
*.sql.bak

# Logs y depuración
*.log
error_log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Configuraciones de IDE y editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.settings/

# Archivos del sistema operativo
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
